# ==============================================================
# Bremen Market Square (bremenmarketsquare.com) - 部署环境变量
# 复制为 .env 或注入 CI/构建环境；静态导出在“构建时”读取这些值。
# ==============================================================

# 站点裸域名（不含协议）。用于生成全部绝对地址：
# canonical / hreflang / Open Graph / JSON-LD / sitemap.xml / robots.txt
# 未设置时回退到 src/lib/site.ts 中的默认域名。
CURRENT_SITE_DOMAIN=bremenmarketsquare.com
