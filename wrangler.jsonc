{
  // 纯静态站点（next.config.ts 为 output: 'export'，产物在 out/）。
  // 存在本文件可阻止 wrangler deploy 触发 OpenNext/框架自动迁移，
  // 直接按 Workers Static Assets 上传 out/ 目录。
  "name": "bremenmarketsquare",
  "compatibility_date": "2026-09-05",
  "assets": {
    "directory": "./out",
    // 未命中路径返回 out/404.html
    "not_found_handling": "404-page"
  }
}
